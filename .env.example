# Copy to .env and fill in what you need. Environment variables already set win over this file.

# Claude coaching reports (optional). Without a key the app still works and writes a rule-based summary.
# ANTHROPIC_API_KEY=sk-ant-...
# PITCHLAB_LLM_MODEL=claude-opus-5-5

# Server
# PITCHLAB_HOST=127.0.0.1
# PITCHLAB_PORT=8091

# Limits
# PITCHLAB_MAX_UPLOAD_MB=600
# PITCHLAB_MAX_FRAMES=4000
# PITCHLAB_ANALYSIS_MAX_SIDE=1280
# PITCHLAB_RENDER_MAX_SIDE=960

# Storage (defaults: ./data and ./assets)
# PITCHLAB_DATA_DIR=C:\path\to\data
# PITCHLAB_ASSETS_DIR=C:\path\to\assets
